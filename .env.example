# ─── App ───────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ─── Database (PostgreSQL via Prisma) ──────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/vroomy_db?schema=public"

# ─── JWT ───────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_SUPER_SECRET_KEY
JWT_EXPIRES_IN=7d

# ─── Rate Limiting ─────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Platform Commission ───────────────────────
PLATFORM_COMMISSION_RATE=0.12
